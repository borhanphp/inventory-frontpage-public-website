# ─────────────────────────────────────────────────────────────
# Zeeventory website — copy to .env.local and fill in what you use.
# Anything left blank is simply switched off.
# ─────────────────────────────────────────────────────────────

# Where "Sign in" / "Start free trial" buttons point
NEXT_PUBLIC_ZEEVENTORY_APP_URL=https://app.zeeventory.com


# ═════════════ Demo booking → CRM / marketing systems ═════════════
# Every configured destination receives each booking (in parallel).
# The visitor sees success if at least one destination accepts it.
# Add new systems in lib/integrations/ (see lib/integrations/index.js).

# 1) Zeeventory CRM — bookings become Leads in your own workspace
#    API base of the Zeeventory backend (ends in /api) and the org that owns the leads
ZEEVENTORY_CRM_API_URL=
ZEEVENTORY_CRM_ORG_SLUG=

# 2) Webhooks — connect ANY system: Zapier, Make, n8n, Pabbly, Slack,
#    Pipedrive, Salesforce, Zoho, Google Sheets, your own API…
#    Comma-separate several URLs. Payload: { "event": "demo.booked", "data": { ...lead } }
DEMO_WEBHOOK_URLS=
#    Optional: signs the raw body → header  X-Zeeventory-Signature: sha256=<hmac hex>
DEMO_WEBHOOK_SECRET=

# 3) HubSpot (Forms API) — create a form with fields:
#    email, firstname, lastname, phone, company, jobtitle, message
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# 4) Mailchimp — adds the person to an audience tagged "Demo request"
#    (subscribed only if they tick the marketing opt-in box)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Max time to wait for each destination (ms)
DEMO_INTEGRATION_TIMEOUT_MS=8000


# ═════════════ Marketing / analytics tags (all pages) ═════════════
# On a successful booking the site fires a "demo_booked" event to every loaded tag
# (dataLayer / GA4 event, Meta "Schedule", LinkedIn conversion).

# Google Tag Manager — easiest way to add any other tag without code changes
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 (only if you don't load GA through GTM)
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag + the conversion to record for demo bookings
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
